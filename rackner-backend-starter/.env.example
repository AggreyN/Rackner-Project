# Copy to .env and fill in.  .env is git-ignored — never commit real secrets.

# --- Database ---
DATABASE_URL=postgresql+psycopg://localhost:5432/rackner_fdi

# --- Auth mode: "local" (bcrypt demo, no AWS) or "cognito" ---
AUTH_MODE=local

# --- Local mode only: signing secret for our short-lived JWTs ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=720

# --- Cognito mode only (leave blank in local mode) ---
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# --- CORS: comma-separated frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000
