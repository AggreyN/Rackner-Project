# Copy this file to ".env" and adjust if needed:   cp .env.example .env
# .env is git-ignored so your real settings stay private.

# --- Database ---
# Local Postgres (created with:  createdb rackner):
DATABASE_URL=postgresql+psycopg://localhost:5432/rackner
# No Postgres yet? A file-based SQLite DB works for local dev and tests:
# DATABASE_URL=sqlite:///./dev.db
