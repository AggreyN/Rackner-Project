# Copy this file to ".env" and adjust if needed:   cp .env.example .env
# .env is git-ignored so your real settings stay private. NEVER commit secrets.

# --- Database ---
# Local Postgres (created with:  createdb rackner):
DATABASE_URL=postgresql+psycopg://localhost:5432/rackner
# No Postgres yet? A file-based SQLite DB works for local dev and tests:
# DATABASE_URL=sqlite:///./dev.db

# --- Claude / extraction ---
# Only needed once Kaliza's extraction/extractor.py is in place; without it the
# adapter falls back to a deterministic mock.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-4-5

# --- Document retention (security requirement) ---
# Uploaded contracts are hard-deleted this many days after upload.
RETENTION_DAYS=3

# --- File storage ---
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50

# --- Auth (Week 6; off by default so the demo needs no accounts) ---
AUTH_ENABLED=false
# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=12

# --- CORS (comma-separated) ---
ALLOWED_ORIGINS=http://localhost:3000,https://main.d3rvrftm36ntnq.amplifyapp.com
