# Copy to .env and fill in.  .env is git-ignored — never commit real secrets.

# --- Core ---
APP_ENV=dev                        # dev (.env) | prod (AWS Secrets Manager)

# --- Database ---
DATABASE_URL=postgresql+psycopg://localhost:5432/rackner_fdi

# --- Auth mode: "local" (bcrypt demo, no AWS) or "cognito" ---
AUTH_MODE=local

# --- Local mode only: signing secret for our short-lived JWTs ---
# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production
JWT_EXPIRY_MINUTES=720

# --- Cognito mode only (leave blank in local mode) ---
# Backend needs pool id + app client id + region. The hosted-UI domain
# (https://<domain>.auth.<region>.amazoncognito.com) is FRONTEND config — the
# backend never touches it. NOTE: send the ID token to the API, not the access
# token; validation checks `aud` = app client id, which only ID tokens carry.
AWS_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# --- CORS: comma-separated frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000,https://main.d3rvrftm36ntnq.amplifyapp.com

# --- LLM gateway ---
# "mock" runs with no AWS and no cost (default). "bedrock" calls real Claude.
LLM_MODE=mock
# Only used when LLM_MODE=bedrock. US cross-region inference profile keeps
# inference in US regions (data residency for federal work).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
LLM_MAX_TOKENS=4096
# When LLM_MODE=bedrock, provide AWS credentials the usual way (env vars below,
# an AWS profile, or an IAM role). Leave blank in mock mode.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- External government data ---
# SAM.gov Get Opportunities key (from data.gov). Unset → those routes 503.
SAM_GOV_API_KEY=your-sam-gov-api-key-here

# --- OCR for scanned/image-only PDFs: "off" (default) or "textract" ---
# "textract" OCRs only the pages with no text layer, via the synchronous
# DetectDocumentText API (no S3 needed). Requires AWS credentials with
# textract:DetectDocumentText.
OCR_MODE=off

# --- Storage: "local" filesystem (dev) or "s3" (prod) ---
STORAGE_BACKEND=local
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50
S3_BUCKET=
KMS_KEY_ID=

# --- Tunables (safe defaults; override only if needed) ---
# SAM_SEARCH_TTL_HOURS=12        # repeat searches inside this window are cache-served (0 disables)
# SAM_MAX_ATTACHMENTS=8          # per-notice attachment download cap
# SAM_ATTACHMENT_MAX_MB=25       # per-file size cap (streamed)
# SAM_ATTACHMENTS_TOTAL_MB=60    # per-document total cap
# LLM_MAX_EXTRACT_SECTIONS=60    # bedrock extraction section cap
# LLM_EXTRACT_CONCURRENCY=8      # parallel per-section extraction width
# CHAT_MAX_TOKENS=8192           # chat answer headroom
# CHAT_MAX_SECTION_CHARS=120000  # chat grounding-context budget
# FIT_PRESCREEN_MAX_ROWS=60      # AI card pre-screen batch cap
# FIT_PRESCREEN_MIN_ROWS=2       # below this, heuristic only (detail views)
