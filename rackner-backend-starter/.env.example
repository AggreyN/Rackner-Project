# Copy to .env and fill in.  .env is git-ignored — never commit real secrets.

# --- Database ---
DATABASE_URL=postgresql+psycopg://localhost:5432/rackner_fdi

# --- Auth mode: "local" (bcrypt demo, no AWS) or "cognito" ---
AUTH_MODE=local

# --- Local mode only: signing secret for our short-lived JWTs ---
# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production
JWT_EXPIRY_MINUTES=720

# --- Cognito mode only (leave blank in local mode) ---
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# --- CORS: comma-separated frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000,https://main.d3rvrftm36ntnq.amplifyapp.com

# --- LLM gateway ---
# "mock" runs with no AWS and no cost (default). "bedrock" calls real Claude.
LLM_MODE=mock
# Only used when LLM_MODE=bedrock. US cross-region inference profile keeps
# inference in US regions (data residency for federal work).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
LLM_MAX_TOKENS=4096
# When LLM_MODE=bedrock, provide AWS credentials the usual way (env vars below,
# an AWS profile, or an IAM role). Leave blank in mock mode.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Ingestion (PDF → text + word bounding boxes) ---
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50
