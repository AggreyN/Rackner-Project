# Python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Sync-daemon conflict copies. iCloud/Dropbox recreate deleted files as
# "extract_pdf 2.py" — never commit those.
* [0-9].*

# Environment / secrets — NEVER commit these
.env

# Local SQLite (used for quick smoke tests only; prod is Postgres)
*.db

# Data — don't commit downloaded PDFs or uploaded plans
data/samples/*
!data/samples/.gitkeep
data/uploads/

# Test artifacts
.pytest_cache/

# OS / editor
.DS_Store
.vscode/
.idea/
